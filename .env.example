SNAPFORGE_API_KEY=replace-with-strong-api-key
HOST_PORT=4010
PORT=4000
CACHE_DIR=/app/cache
SCRAPE_CACHE_DIR=/app/cache/scrape
CACHE_TTL_SECONDS=300
SCRAPE_CACHE_TTL_SECONDS=300
NAVIGATION_TIMEOUT_MS=15000
MAX_VIEWPORT_WIDTH=1920
MAX_VIEWPORT_HEIGHT=1080
MAX_TEXT_LENGTH=20000
MAX_HTML_LENGTH=100000
MAX_LINKS=100
MAX_CONCURRENT_PAGES=2
ALLOW_PRIVATE_NETWORKS=false
# Optional hostnames, comma-separated:
# URL_ALLOWLIST=example.com,vercel.com
# URL_DENYLIST=internal.example.com
# Future optional enrichment:
# OPENAI_API_KEY=
