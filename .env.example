## Required
SNAP_GOBLIN_API_KEY=replace-with-strong-api-key

## Docker port mapping
HOST_PORT=4010
PORT=4000

## Cache paths
CACHE_DIR=/app/cache
SCRAPE_CACHE_DIR=/app/cache/scrape

## Optional public origin for absolute image URLs
PUBLIC_BASE_URL=

## Cache and browser behavior
CACHE_TTL_SECONDS=300
SCRAPE_CACHE_TTL_SECONDS=300
NAVIGATION_TIMEOUT_MS=15000
MAX_VIEWPORT_WIDTH=1920
MAX_VIEWPORT_HEIGHT=1080
MAX_TEXT_LENGTH=100000
MAX_HTML_LENGTH=100000
MAX_LINKS=100
MAX_CONCURRENT_PAGES=2

## Basic in-memory rate limiting
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=120
UNAUTH_RATE_LIMIT_MAX=30

## URL access controls
ALLOW_PRIVATE_NETWORKS=false

# Use a long random API key and rotate it if you suspect exposure.
# Optional hostnames, comma-separated:
# URL_ALLOWLIST=example.com,vercel.com
# URL_DENYLIST=internal.example.com
# PUBLIC_BASE_URL=https://snap-goblin.example.com

# Future optional enrichment:
# OPENAI_API_KEY=
