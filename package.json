{
  "name": "snap_goblin",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted Playwright API for screenshots and rendered page scraping.",
  "repository": {
    "type": "git",
    "url": "https://git.cameronlow.com/cam/SnapGoblin.git"
  },
  "homepage": "https://git.cameronlow.com/cam/SnapGoblin",
  "bugs": {
    "url": "https://git.cameronlow.com/cam/SnapGoblin/issues"
  },
  "keywords": [
    "playwright",
    "screenshot",
    "scraper",
    "scraping",
    "express",
    "automation",
    "ai"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "express": "^5.1.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
